# Copy to .env and fill in. Never commit .env; it is covered by .gitignore.
# The API refuses to start if a required value is missing or too weak.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Use a least-privilege role: the application
# needs DML on its own schema, not DDL or superuser rights.
DATABASE_URL=postgresql://user:password@localhost:5432/land_acquisition

# Minimum 32 characters, generated from a cryptographic source, unique per
# environment. Rotating it invalidates every issued token, which is the intended
# emergency control. Example generator:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=land-acquisition-api
JWT_AUDIENCE=land-acquisition-clients

# Explicit origin allow-list, comma separated. "*" is refused at boot because
# this API sends credentials. Outside localhost, every origin must use https.
CORS_ORIGIN=http://localhost:3000

# Express trust-proxy setting. Decides whether x-forwarded-for is believed, and
# therefore whether audited IP addresses and rate-limit buckets are trustworthy.
# "loopback" trusts nothing upstream; behind one load balancer, use "1".
TRUST_PROXY=loopback

# Model service. Must be http or https. Redirects are refused and the response
# is size-bounded and schema-validated. Leave blank to run rule-only.
ML_SERVICE_URL=
ML_SERVICE_TIMEOUT_MS=3000

# Rate limits, per address.
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_EXPENSIVE=10
RATE_LIMIT_EXPORT=5

# Account lockout after repeated failed logins.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# The OpenAPI explorer documents the whole attack surface. It is refused in
# production regardless of this setting.
ENABLE_API_DOCS=false

# Seeding only. Minimum 12 characters. Demo environments only.
DEMO_ADMIN_PASSWORD=
